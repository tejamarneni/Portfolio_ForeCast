# Byte-compiled / optimized Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging / build output (anchored to repo root so src/lib etc. aren't ignored)
/build/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key

# Local project data & cached prices (keep .gitkeep so the folders exist)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.parquet

# Serialized model binaries (store large artifacts outside git)
models/*
!models/.gitkeep
*.pkl
*.joblib
*.pt
*.onnx
!tests/fixtures/*.pkl
!tests/fixtures/*.parquet

# Jupyter
.ipynb_checkpoints

# Testing & code quality caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs
*.log

